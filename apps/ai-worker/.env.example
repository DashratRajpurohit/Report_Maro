NODE_ENV=development

# Redis (same instance the API's BullMQ producer uses)
REDIS_URL=redis://localhost:6379

# Internal API (apps/api)
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1/internal
INTERNAL_API_SECRET=change-me-internal-secret

# Duplicate-detection threshold (cosine similarity, 0-1)
DEDUPE_MIN_SCORE=0.8

# Optional fallback — classifier works fully offline without this.
# Leave blank to disable; the primary rule-based path never depends on it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFIER_CONFIDENCE_FALLBACK_THRESHOLD=0.55
