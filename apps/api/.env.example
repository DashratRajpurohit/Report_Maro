NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://sih:sih_dev_password@localhost:5432/sih_portal?schema=public

# Mongo (raw AI debug payloads)
MONGO_URL=mongodb://sih:sih_dev_password@localhost:27017/sih_portal?authSource=admin

# Redis (BullMQ + Socket.io adapter, same instance for the hackathon)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AI worker <-> API. Never commit the real value.
INTERNAL_API_SECRET=change-me-internal-secret

# Object storage (MinIO locally; swap for real S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sih-portal-uploads
S3_ACCESS_KEY_ID=sih_minio
S3_SECRET_ACCESS_KEY=sih_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/sih-portal-uploads
