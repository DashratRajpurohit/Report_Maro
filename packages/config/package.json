{
  "name": "@sih/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared eslint / tsconfig / prettier bases for the monorepo",
  "type": "module",
  "main": "eslint.base.js",
  "exports": {
    "./eslint.base.js": "./eslint.base.js",
    "./eslint.react.js": "./eslint.react.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./prettier.json": "./prettier.json"
  },
  "files": ["*.js", "*.json"],
  "scripts": {
    "lint": "echo \"(config) nothing to lint\"",
    "typecheck": "echo \"(config) nothing to typecheck\"",
    "test": "echo \"(config) no tests\""
  },
  "dependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript-eslint": "^8.11.0"
  }
}
